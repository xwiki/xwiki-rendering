.runTransformations
.#-----------------------------------------------------
.input|xwiki/2.0
.# Verify that a box without content renders an empty box, standalone and inline.
.#-----------------------------------------------------
{{box/}}

a {{box/}} b
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginMacroMarkerStandalone [box] []
beginGroup [[class]=[box]]
beginMetaData [[non-generated-content]=[java.util.List<org.xwiki.rendering.block.Block>]]
endMetaData [[non-generated-content]=[java.util.List<org.xwiki.rendering.block.Block>]]
endGroup [[class]=[box]]
endMacroMarkerStandalone [box] []
beginParagraph
onWord [a]
onSpace
beginMacroMarkerInline [box] []
beginFormat [NONE] [[class]=[box]]
beginMetaData [[non-generated-content]=[java.util.List<org.xwiki.rendering.block.Block>]]
endMetaData [[non-generated-content]=[java.util.List<org.xwiki.rendering.block.Block>]]
endFormat [NONE] [[class]=[box]]
endMacroMarkerInline [box] []
onSpace
onWord [b]
endParagraph
endDocument
